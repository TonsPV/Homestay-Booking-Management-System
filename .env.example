NODE_ENV=development
APP_PORT=3000
CORS_ORIGINS=http://localhost:5173

# Google Identity Services for customer sign-in. Keep disabled until a Web
# OAuth client is configured for the frontend origin.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
# Enable Swagger UI and OpenAPI JSON endpoints.
# Keep false in production unless access is protected.
SWAGGER_ENABLED=false
HTTP_JSON_BODY_LIMIT=1mb
HTTP_URLENCODED_BODY_LIMIT=1mb

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=property_user
DB_PASSWORD=your_database_password
DB_DATABASE=property_management
DB_POOL_SIZE=10
DB_POOL_QUEUE_LIMIT=50
DB_CONNECT_TIMEOUT_MS=5000
HEALTH_DB_PROBE_TIMEOUT_MS=1000

MYSQL_ROOT_PASSWORD=your_root_password

JWT_ACCESS_TOKEN_SECRET=development-only-secret-change-before-production-2026
JWT_ACCESS_TOKEN_EXPIRES_IN=1h
BOOKING_PAYMENT_TIMEOUT_MINUTES=15
BOOKING_MAX_ACTIVE_UNPAID_PER_CUSTOMER=3
BOOKING_MAX_HELD_NIGHTS_PER_CUSTOMER=30
BOOKING_MAX_ADVANCE_DAYS=365
EXPIRATION_SCHEDULERS_ENABLED=true
ROOM_IMAGE_UPLOAD_DIR=.data/uploads/room-images

VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/api/v1/payments/vnpay/return
VNPAY_FRONTEND_RETURN_URL=http://localhost:5173/payments/vnpay/return
VNPAY_REQUEST_TIMEOUT_MS=10000

SEED_ADMIN_FULL_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=replace_with_a_strong_password
