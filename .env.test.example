NODE_ENV=test

APP_PORT=3001
CORS_ORIGINS=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=property_user
DB_PASSWORD=your_test_database_password
DB_DATABASE=property_management_test

JWT_ACCESS_TOKEN_SECRET=replace_with_a_distinct_test_secret_at_least_32_chars
JWT_ACCESS_TOKEN_EXPIRES_IN=1h
BOOKING_PAYMENT_TIMEOUT_MINUTES=15
ROOM_IMAGE_UPLOAD_DIR=.data/test-uploads/room-images

VNPAY_ENABLED=true
VNPAY_TMN_CODE=TEST0001
VNPAY_HASH_SECRET=test-vnpay-secret-at-least-16-characters
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3001/api/v1/payments/vnpay/return
VNPAY_FRONTEND_RETURN_URL=
