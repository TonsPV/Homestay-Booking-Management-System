NODE_ENV=test

APP_PORT=3001
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true
HTTP_JSON_BODY_LIMIT=1mb
HTTP_URLENCODED_BODY_LIMIT=1mb

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=property_user
DB_PASSWORD=your_test_database_password
DB_DATABASE=property_management_test
DB_POOL_SIZE=10
DB_POOL_QUEUE_LIMIT=50
DB_CONNECT_TIMEOUT_MS=5000

JWT_ACCESS_TOKEN_SECRET=replace_with_a_distinct_test_secret_at_least_32_chars
JWT_ACCESS_TOKEN_EXPIRES_IN=1h
BOOKING_PAYMENT_TIMEOUT_MINUTES=15
BOOKING_MAX_ACTIVE_UNPAID_PER_CUSTOMER=3
BOOKING_MAX_HELD_NIGHTS_PER_CUSTOMER=30
# Existing E2E fixtures use fixed dates through 2034.
BOOKING_MAX_ADVANCE_DAYS=3650
EXPIRATION_SCHEDULERS_ENABLED=false
ROOM_IMAGE_UPLOAD_DIR=.data/test-uploads/room-images

# Deterministic in-memory delivery is permitted only in NODE_ENV=test.
CUSTOMER_CLAIM_SMS_ENABLED=true
CUSTOMER_CLAIM_SMS_PROVIDER=test
CUSTOMER_CLAIM_LOCAL_BYPASS_ENABLED=true
CUSTOMER_CLAIM_OTP_LIFETIME_MINUTES=5
CUSTOMER_CLAIM_OTP_MAX_ATTEMPTS=5
CUSTOMER_CLAIM_OTP_RESEND_COOLDOWN_SECONDS=60
CUSTOMER_CLAIM_OTP_RATE_WINDOW_MINUTES=15
CUSTOMER_CLAIM_OTP_PHONE_WINDOW_LIMIT=3
CUSTOMER_CLAIM_OTP_PHONE_DAILY_LIMIT=10
CUSTOMER_CLAIM_OTP_IP_WINDOW_LIMIT=20
CUSTOMER_CLAIM_TOKEN_LIFETIME_MINUTES=10

VNPAY_ENABLED=true
VNPAY_TMN_CODE=TEST0001
VNPAY_HASH_SECRET=test-vnpay-secret-at-least-16-characters
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3001/api/v1/payments/vnpay/return
VNPAY_FRONTEND_RETURN_URL=
